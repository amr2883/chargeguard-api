generator client {
  provider = "prisma-client-js"
binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== Tenant (SaaS Client) ==========
model Tenant {
  id            String   @id @default(cuid())
  email         String   @unique
  apiKey        String?  @unique // DEPRECATED (CWE-256) — plaintext, retained only for migration fallback. Never read for new auth checks; do not reintroduce reliance on this field.
  apiKeyHash    String?  @unique // HMAC-SHA256(apiKey, API_KEY_HASH_SECRET) — source of truth for authentication (OWASP ASVS V6.2.1)
storeUrl      String?
  allowedDomains String[] @default([])
  webhookSecret String?
  plan          String   @default("early_access")

  // Agency-only. 'pooled' (default) = current behavior, unchanged for every
  // existing tenant. 'per_store' = Tier-1 signals (Order velocity,
  // CardTestAttempt velocity, Blacklist/Whitelist) filter by req.storeId.
  // BIN sequence detection and the Identity Graph are NEVER isolated by
  // this flag — see binSequenceDetector.js / identityGraph.js.
  fraudIsolationMode String @default("pooled")

  // ========== Subscription Fields ==========
  subscriptionStatus          String    @default("free")
  subscriptionEndDate         DateTime?
  billingCycle                String?
  lastPaymentDate             DateTime?
  lastPaymentAmount           Float?
  lastCaptureId               String?   @unique
  isActive                    Boolean   @default(true)
  monthlyBlockedCount         Int       @default(0)
  quotaResetDate               DateTime?
  emailVerified               Boolean   @default(false)
  emailVerifyToken            String?   @unique
  emailVerifyExpiresAt        DateTime?
  keyRotatedAt                DateTime?
  connectToken                String?   @unique
  connectTokenExpiresAt       DateTime?
  connectRequestId            String?   @unique
  lastConnectVerifiedAt       DateTime?
  // H1 fix: staged storeUrl/domain-binding change, applied only after the
  // merchant proves inbox control by clicking the connect confirmation
  // link (see /connect and /connect/confirm in routes/auth.js). Never
  // written to storeUrl/allowedDomains directly from /connect.
  pendingStoreUrl              String?
  pendingNormalizedDomain      String?
  previousApiKey               String?   @unique // DEPRECATED (CWE-256) — plaintext, retained only for migration fallback.
  previousApiKeyHash           String?   @unique
  previousApiKeyExpiresAt      DateTime?
  // Shared secret for the read-only remote plugin-config viewer
  // (GET /admin/tenants/:id/config). Entered manually by an admin — see
  // POST /admin/tenants/:id/config-key — after being generated by the
  // plugin (chargeguard_admin_config_key option, auto-generated on first
  // load of class-remote-config.php). Deliberately separate from
  // apiKey/apiKeyHash: apiKey is no longer stored in reversible form
  // (CWE-256 fix), and this feature needs a value the backend can present
  // outbound, not just compare.
  remoteConfigKey               String?
  lastAlertSentAt             DateTime?
  lastPaypalAlertAt           DateTime?
  lastRenewalReminderSentAt   DateTime?
  lastGracePeriodNoticeSentAt DateTime?
  lastDowngradeNoticeSentAt   DateTime?
  // Cooldown gate for sendQuotaExceededEmail — same pattern as the four
  // lastXNoticeSentAt fields above. Reset to null by checkQuotaGate()'s
  // lazy monthly reset alongside monthlyBlockedCount, so a tenant who
  // exceeds quota again in a later cycle gets notified again.
  lastQuotaExceededNoticeSentAt DateTime?
  countryOverrides            Json?     @default("{}")
  countryOverridesUpdatedAt   DateTime?
  webhookUrl                  String?
  webhookType                 String?
  webhookResolvedIp           String?   // DNS-resolved IP of webhookUrl's host at validation time (SSRF/TOCTOU defense — see class-api-client.php webhook_save() and POST /settings/webhook)
  webhookLastStatus           String?
  webhookLastSentAt           DateTime?
  webhookFailureCount         Int       @default(0)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  profiles          MerchantProfile[]  @relation("TenantProfiles")
  blockedAttempts   BlockedAttempt[]   @relation("TenantBlockedAttempts")
  alertLogs         AlertLog[]         @relation("TenantAlerts")
  binSequenceAlerts BinSequenceAlert[] @relation("TenantBinAlerts")
  monthlyReports    MonthlyReport[]    @relation("TenantMonthlyReports")
  checkoutSessions  CheckoutSession[]  @relation("TenantCheckoutSessions")
  payments          Payment[]          @relation("TenantPayments")
  stores            Store[]            @relation("TenantStores")
  adminActions      AdminAction[]      @relation("TenantAdminActions")
  protectionEvents  ProtectionEvent[]  @relation("TenantProtectionEvents")
}

// ========== Merchant Profile ==========
model MerchantProfile {
  id                  String @id @default(cuid())
  merchantId          String @unique
  totalOrders         Int    @default(0)
  totalAmount         Float  @default(0)
  avgOrderValue       Float  @default(0)
  totalDisputes       Int    @default(0)
  wonDisputes         Int    @default(0)
  lostDisputes        Int    @default(0)
  merchantWeightRatio Float  @default(0.0)

  // ===== حقول جديدة للثقة (Merchant Trust) =====
  trustScore  Float @default(0.3)
  reportCount Int   @default(0)

  tenantId String?
  tenant   Tenant? @relation("TenantProfiles", fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== Signal Statistics ==========
model SignalStat {
  id          String    @id @default(cuid())
  merchantId  String? // null = global
  signalType  String
  signalValue String
  rawWins     Int       @default(0)
  rawLosses   Int       @default(0)
  totalEvents Int       @default(0)
  confidence  Float     @default(0.5)
  lastDecayAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([merchantId, signalType, signalValue])
  @@index([merchantId])
}

// ========== Order (جديد) ==========
model Order {
  id                 String  @id @default(cuid())
  orderId            String  // معرف الطلب من WooCommerce — NOT globally unique: WooCommerce order IDs are per-store auto-increment integers, so two different merchants can legitimately have the same orderId. Uniqueness is scoped per tenant via the compound @@unique below (C3 fix).
  merchantId         String
  storeId            String? // Agency isolation (opt-in) — null for pooled/legacy rows and for Starter/Pro tenants. Never part of the (merchantId, orderId) uniqueness key.
  amount             Float
  currency           String  @default("USD")
  email              String?
  ipAddress          String?
  customerLoginId    String?
  deviceFingerprint  String?
  fingerprintVersion String?
  fingerprintStatus  String?
  riskScore          Int?
  riskLevel          String? // low, medium, high
  decision           String? // approve, review, block
  connectedRisk      Int?    @default(0)
  cardHash           String? // optional reference to CardHash.cardHash

  // لقطة من الإشارات المستخرجة وقت التقييم (JSON)
  signalsSnapshot String?

  // L3 perf fix: denormalized copy of signalsSnapshot.enrichmentSource,
  // written once at /enrich time. Lets the weekly PayPal scheduler filter
  // via an indexed WHERE clause instead of loading every tenant order into
  // memory and JSON.parse()-ing signalsSnapshot per row. NULL for any order
  // that hasn't gone through /enrich yet (matches current "no signal, not
  // PayPal" semantics) — see backfill script for pre-existing rows.
  enrichmentSource String?

  // C‑IDEMPOTENCY fix: atomic idempotency gate for processFeedbackSimplified().
  // NULL = feedback not yet processed for this order; non-null = the exact
  // moment a feedback call first successfully claimed this order. Guarded via
  // an `updateMany` with `WHERE feedbackProcessedAt IS NULL` in feedbackLoop.js
  // — a database-atomic conditional update, not a separate check-then-act.
  feedbackProcessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // علاقات (اختيارية لكن مفيدة)
  riskEvaluations RiskEvaluation[]
  disputeOutcomes DisputeOutcome[]

  // Composite indexes for the four hot-path query patterns run on every
  // /evaluate, /woocommerce-webhook, and /enrich request (merchant-scoped
  // recent-order lookups and device/IP/email velocity counts). Matches the
  // style already established on BlockedAttempt.
  @@index([merchantId, createdAt])
  @@index([merchantId, deviceFingerprint, createdAt])
  @@index([merchantId, ipAddress, createdAt])
  @@index([merchantId, email, createdAt])
  // Matches the weekly PayPal scheduler's exact predicate shape:
  // WHERE merchantId = ? AND enrichmentSource = ? AND createdAt >= ?
  @@index([merchantId, enrichmentSource, createdAt])
  // Tier-1 isolation query shapes (per_store mode) — mirror the existing
  // merchantId-only indexes above with storeId inserted before the
  // time/velocity predicate, so per_store tenants get an index range scan
  // instead of a sequential scan filtered post-hoc.
  @@index([merchantId, storeId, createdAt])
  @@index([merchantId, storeId, deviceFingerprint, createdAt])
  @@index([merchantId, storeId, ipAddress, createdAt])
  @@index([merchantId, storeId, email, createdAt])

  // CRITICAL FIX (C3): orderId alone was globally @unique, meaning two
  // different merchants could never both have an order with the same
  // orderId — but WooCommerce order IDs are per-store auto-increment
  // integers, so collisions across tenants are routine, not exceptional.
  // Scoping uniqueness to (merchantId, orderId) is the same multi-tenant
  // isolation pattern already used by BlacklistEntry, WhitelistEntry, and
  // IdentityNode in this file; Order was the one model that omitted it.
  // This constraint is what makes the compound-key queries in
  // routes/risk.js structurally correct — the database itself now
  // guarantees a findUnique/upsert scoped to (merchantId, orderId) can
  // only ever touch that tenant's row.
  @@unique([merchantId, orderId])
}

// ========== Risk Evaluation (Flight Recorder) ==========
model RiskEvaluation {
  id      String @id @default(cuid())
  orderId String @unique
  // ربط بالـ Order (جديد)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  staticScore     Float
  learningScore   Float
  finalDecision   String
  topSignals      String   @default("[]")
  positiveSignals String   @default("[]")
  scoringVersion  String
  outcomeStatus   String   @default("PENDING")
  createdAt       DateTime @default(now())

  // Economic snapshot
  fraudProb      Float?
  expectedLoss   Float?
  thresholdUsed  Float?
  decisionBefore String?
  decisionAfter  String?
}

// ========== Dispute Outcome (for learning) ==========
model DisputeOutcome {
  id         String  @id @default(cuid())
  disputeId  String  @unique
  merchantId String
  orderId    String?
  // ربط بالـ Order (جديد)
  order      Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  result         String // "won" or "lost"
  signalsPresent String   @default("[]")
  caseScore      Int?
  resolvedAt     DateTime @default(now())
}

// ========== Pattern Sharing (Cross-Merchant Learning) ==========
model FraudPattern {
  id             String   @id @default(cuid())
  patternHash    String   @unique
  patternDesc    String?
  signalCount    Int      @default(0)
  weightedScore  Float    @default(0)
  fraudCount     Int      @default(0)
  legitCount     Int      @default(0)
  totalCount     Int      @default(0)
  signals        String? // JSON array of signal types
  merchantsSeen  Int      @default(0)
  version        Int      @default(0)
  learnedAtCount Int?
  clusterId      String?
  firstSeen      DateTime @default(now())
  lastSeen       DateTime @updatedAt

  cluster FraudCluster? @relation(fields: [clusterId], references: [id])

  @@index([patternHash])
  @@index([clusterId])
  @@index([lastSeen])
  @@index([fraudCount])
}

model FraudCluster {
  id                 String   @id @default(cuid())
  clusterHash        String   @unique
  clusterDesc        String?
  totalCount         Int      @default(0)
  fraudCount         Int      @default(0)
  merchantsSeen      Int      @default(0)
  weightedFraudScore Float    @default(0)
  firstSeen          DateTime @default(now())
  lastSeen           DateTime @updatedAt

  patterns FraudPattern[]

  @@index([clusterHash])
  @@index([fraudCount])
}

model PatternMerchant {
  patternHash String
  merchantId  String
  createdAt   DateTime @default(now())

  @@id([patternHash, merchantId])
  @@index([patternHash])
}

// ========== Identity Graph ==========
model IdentityNode {
  id                  String    @id @default(cuid())
  merchantId          String?
  type                String // DEVICE, EMAIL, IP, ADDRESS, FINGERPRINT
  hashedValue         String // HMAC-SHA256(`${type}:${normalizedValue}`, IDENTITY_GRAPH_SECRET) — peppered, per OWASP ASVS V6.2.4. Uses a separate secret from BlockedAttempt/CardTestAttempt's SECRET_SALT by design (see identityGraph.js hashValue()) — deliberate isolation between the velocity-tracking and cross-merchant identity-graph subsystems, not an inconsistency to "fix."
  maskedValue         String?
  fingerprintConfig   String?
  fingerprintHardware String?
  fraudEvents         Int       @default(0)
  successOrders       Int       @default(0)
  chargebacks         Int       @default(0)
  totalTransactions   Int       @default(0)
  merchantsSeen       Int       @default(0)
  recentMerchants     Int       @default(0)
  flaggedAtCount      Int?
  lastHealedAt        DateTime?
  firstSeen           DateTime  @default(now())
  lastSeen            DateTime  @default(now())

  // علاقات مع IdentityEdge
  fromEdges IdentityEdge[] @relation("fromEdges")
  toEdges   IdentityEdge[] @relation("toEdges")

  @@unique([merchantId, type, hashedValue])
  @@index([merchantId, type, lastSeen])
  @@index([hashedValue])
}

model IdentityEdge {
  id           String   @id @default(cuid())
  fromId       String
  toId         String
  relation     String // LINKED_TO, USED_WITH, SHIPPED_TO, LOGGED_FROM
  seenCount    Int      @default(1)
  uniqueOrders Int      @default(1)
  orderId      String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  from IdentityNode @relation("fromEdges", fields: [fromId], references: [id], onDelete: Cascade)
  to   IdentityNode @relation("toEdges", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, relation])
  @@index([fromId])
  @@index([toId])
}

model IdentityEvent {
  id            String   @id @default(cuid())
  nodeId        String
  merchantId    String?
  type          String // FRAUD_CONFIRMED, CHARGEBACK, CLEAN_ORDER
  eventCategory String
  weight        Float
  createdAt     DateTime @default(now())

  @@index([nodeId, createdAt])
}

model ComputedIdentityRisk {
  nodeId           String
  algorithmVersion Int
  riskScore        Float
  alertLevel       String?
  fraudWeight      Float
  cleanWeight      Float
  eventCount       Int
  computedAt       DateTime @default(now())

  @@id([nodeId, algorithmVersion])
}

// ========== BIN Local Cache ==========
model BinRecord {
  bin           String   @id
  brand         String?
  cardType      String?
  cardCategory  String?
  issuerName    String?
  issuerCountry String?
  isPrepaid     Boolean  @default(false)
  isCommercial  Boolean  @default(false)
  source        String
  hitCount      Int      @default(1)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
}

// ========== Card Testing Velocity ==========
model CardTestAttempt {
  id         String   @id @default(cuid())
  merchantId String
  storeId    String? // Agency isolation (opt-in) — null for pooled/legacy rows.
  binPrefix  String?
  ipHash     String? // HMAC-SHA256(ip, SECRET_SALT) — peppered, per OWASP ASVS V6.2.4. Same key as BlockedAttempt.ipHash (see velocityDetector.js), so the two are directly correlatable.
  emailHash  String? // HMAC-SHA256(email, SECRET_SALT) — peppered, per OWASP ASVS V6.2.4
  deviceHash String? // HMAC-SHA256(deviceFingerprint, SECRET_SALT) — peppered, per OWASP ASVS V6.2.4
  amount     Float
  wasBlocked Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([merchantId, storeId, createdAt])
  @@index([deviceHash, createdAt])
  @@index([ipHash, createdAt])
}

// ========== Blocked Attempt (Dashboard) ==========
model BlockedAttempt {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation("TenantBlockedAttempts", fields: [tenantId], references: [id], onDelete: Cascade)

  // Agency multi-store attribution — null for Starter/Pro (no Store rows
  // exist) and for any Agency attempt recorded before this field's rollout.
  storeId     String?
  store       Store?   @relation("StoreBlockedAttempts", fields: [storeId], references: [id], onDelete: SetNull)

  blockedAt   DateTime @default(now())
  cardBin     String?  // أول 6 أرقام فقط — لا نخزن رقم البطاقة كاملاً
  cardType    String?  // Visa, Mastercard, Amex, Unknown
  reason      String   // card_testing, velocity, blacklist, pattern
  ipHash      String?  // HMAC-SHA256(ip, SECRET_SALT) — peppered, per OWASP ASVS V6.2.4. لا نخزن IP الكامل (GDPR)
  amountAttempted Float?
  riskScore       Int?

  @@index([tenantId, blockedAt])
  @@index([storeId, blockedAt])
}

// ========== Card Hash Tracking ==========
model CardHash {
  id           String   @id @default(cuid())
  merchantId   String
  cardHash     String   @unique
  last4        String
  expMonth     Int
  expYear      Int
  brand        String
  attemptCount Int      @default(1)
  blockCount   Int      @default(0)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@index([merchantId, cardHash])
  @@index([lastSeenAt])
}

// ========== Pending Enrichment ==========
model PendingEnrichment {
  id              String    @id @default(cuid())
  // Tenant scoping (fix for cross-tenant orderId collisions — see Order
  // model's own comment on why orderId is never globally unique).
  // Nullable only so existing rows created before this migration don't
  // break the unique/index constraints; every new row written by
  // routes/risk.js populates it going forward.
  merchantId      String?
  orderId         String
  paymentIntentId String?
  enrichData      String
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  @@index([orderId])
  @@index([status])
  // Matches the replay job's exact predicate shape:
  // WHERE merchantId = ? AND orderId = ? AND status = 'pending'
  @@index([merchantId, orderId, status])
}

// ========== Blacklist (per merchant) ==========
model BlacklistEntry {
  id         String    @id @default(cuid())
  merchantId String
  storeId    String?   // Agency isolation (opt-in) — null for pooled/legacy entries; nullable so uniqueness below is unaffected for existing rows.
  type       String // EMAIL, IP, DEVICE_FINGERPRINT, BIN
  value      String // القيمة الأصلية (غير مشفرة، لأنها قائمة سوداء صريحة)
  reason     String? // سبب الإضافة
  expiresAt  DateTime? // تاريخ انتهاء الحظر (اختياري)
  createdAt  DateTime  @default(now())
  createdBy  String? // من أضافها (مثل admin@store.com)

  @@unique([merchantId, storeId, type, value])
  @@index([merchantId, type, expiresAt])
  @@index([merchantId, storeId, type, expiresAt])
}

// ========== Whitelist (per merchant) ==========
model WhitelistEntry {
  id         String    @id @default(cuid())
  merchantId String
  storeId    String?   // Agency isolation (opt-in) — null for pooled/legacy entries.
  type       String    // EMAIL, IP, BIN
  value      String
  reason     String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String?

  @@unique([merchantId, storeId, type, value])
  @@index([merchantId, type, expiresAt])
  @@index([merchantId, storeId, type, expiresAt])
}

// ========== Registration Rate Limiting ==========
model RegistrationAttempt {
  id        Int      @id @default(autoincrement())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// ========== Connect (Key Recovery) Rate Limiting ==========
model ConnectAttempt {
  id        Int      @id @default(autoincrement())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// ========== BIN Sequence Alert ==========
model BinSequenceAlert {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation("TenantBinAlerts", fields: [tenantId], references: [id], onDelete: Cascade)
  // Attribution ONLY — records which store's request first created or most
  // recently incremented this alert. The underlying detection window and
  // its threshold counters (binSequenceDetector.js, Redis-backed) remain
  // tenant-wide/pooled by design (Tier 2) — this column does not, and must
  // not be read to, imply the attack itself is isolated to one store.
  storeId       String?
  store         Store?    @relation("StoreBinAlerts", fields: [storeId], references: [id], onDelete: SetNull)
  binPrefix     String
  layer         Int
  reason        String
  cardsCount    Int
  entitiesCount Int
  riskAddition  Int
  status        String    @default("active")
  notifiedAt    DateTime?
  detectedAt    DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([tenantId, status, detectedAt])
  @@index([tenantId, detectedAt])
  @@index([storeId, detectedAt])
}
// ========== Monthly Security Report ==========
model MonthlyReport {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation("TenantMonthlyReports", fields: [tenantId], references: [id], onDelete: Cascade)
  // Agency per-store report (additive). NULL = tenant-wide aggregate —
  // this is the row every existing consumer (dashboard archive, email)
  // reads today and continues to read unchanged.
  storeId      String?
  store        Store?   @relation("StoreMonthlyReports", fields: [storeId], references: [id], onDelete: SetNull)

  reportMonth  Int      // 1–12
  reportYear   Int

  // حالة التوليد
  status       String   @default("generating") // generating | ready | failed

  // الإحصائيات المُجمَّدة وقت الإنشاء — لا تتغير لاحقاً
  totalAttacks       Int?
  totalProtected     Float?   // sum(amountAttempted) — القيمة الفعلية المحمية
  totalFeesSaved     Float?   // attacks × SAVINGS_PER_ATTACK
  securityScore      Int?     // DEPRECATED — legacy composite score, read-only for historical reports. Never written by new report-generation code; see coreLayersActive/advancedLayersAvailable below.
  coreLayersActive        Int?     // count of core detection layers (blacklist/velocity/BIN-sequence/identity-graph) active during this report period
  advancedLayersAvailable Int?     // count of Pro-tier layers the tenant did NOT have active (null for Pro/Agency tenants — nothing to show)
  topCountry         String?
  topReason          String?
  prevMonthAttacks   Int?    // للمقارنة الشهرية

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Widened from [tenantId, reportMonth, reportYear] — storeId is nullable
  // and Postgres treats NULL as distinct across rows in a unique index, so
  // every existing row (all storeId = NULL) keeps its exact prior
  // uniqueness guarantee; this only additionally allows one row per
  // (tenant, store, month, year) to coexist alongside it.
  @@unique([tenantId, storeId, reportMonth, reportYear])
  @@index([tenantId, reportYear, reportMonth])
  @@index([storeId, reportYear, reportMonth])
}


// ========== Checkout Session (مؤقت — يُحذف بعد 30 دقيقة أو إتمام الدفع) ==========
model CheckoutSession {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation("TenantCheckoutSessions", fields: [tenantId], references: [id], onDelete: Cascade)

  planId      String
  // القيم: pro_monthly | pro_annual | agency_monthly | agency_annual

  amount      Float
  // المبلغ المتوقع بالدولار — هذا هو Source of Truth

  billingCycle String
  // monthly | annual

  status      String   @default("pending")
  // pending | completed | expired | failed

  expiresAt   DateTime
  // وقت انتهاء صلاحية الجلسة (عادةً 30 دقيقة من الإنشاء)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ربط بالدفعة بعد اكتمالها
  payment     Payment?

  @@index([tenantId, status])
  @@index([expiresAt])
  // لتسهيل حذف الجلسات المنتهية بـ Cron Job
}

// ========== Payment (سجل دائم لكل عملية دفع ناجحة) ==========
model Payment {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation("TenantPayments", fields: [tenantId], references: [id], onDelete: Cascade)

  checkoutSessionId String   @unique
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id])

  captureId         String   @unique
  // PayPal capture ID — المعرف الفريد للدفعة من PayPal

  amount            Float
  // المبلغ الفعلي الذي دفعه التاجر (من PayPal Webhook)

  expectedAmount    Float
  // المبلغ الذي كان متوقعاً (من CheckoutSession) — للمقارنة والتدقيق

  planId            String
  billingCycle      String
  status            String   @default("completed")
  // completed | refunded | disputed

  paypalOrderId     String?
  // PayPal Order ID (مختلف عن Capture ID)

  paypalPayerId     String?
  // معرف المشتري على PayPal

  createdAt         DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([captureId])
}
// ========== Store (Agency multi-store) ==========
model Store {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation("TenantStores", fields: [tenantId], references: [id], onDelete: Cascade)

  storeUrl         String    // as submitted by the merchant, unnormalized
  normalizedDomain String    // output of normalizeDomain() — source of truth for auth matching
  label            String?   // merchant-facing name, e.g. "Client A — woo.clienta.com"

  // Soft-delete pattern (matches existing status-field conventions in this
  // schema — BinSequenceAlert.status, CheckoutSession.status, Payment.status —
  // rather than a hard DELETE, so historical BlockedAttempt/Order rows keep
  // a valid FK and dashboard history isn't silently orphaned.
  isActive         Boolean   @default(true)
  deactivatedAt    DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastActivityAt   DateTime? // bumped on each /blocked-attempt or /evaluate hit — used for dashboard "last seen"

  blockedAttempts   BlockedAttempt[]   @relation("StoreBlockedAttempts")
  alertLogs         AlertLog[]         @relation("StoreAlertLogs")
  monthlyReports    MonthlyReport[]    @relation("StoreMonthlyReports")
  binSequenceAlerts BinSequenceAlert[] @relation("StoreBinAlerts")

  // One domain per tenant, active or not — re-adding a previously removed
  // domain reactivates this row (see §2) rather than creating a duplicate.
  @@unique([tenantId, normalizedDomain])
  @@index([tenantId, isActive])
  @@index([normalizedDomain])
}

// ========== Attack Alert Log ==========
model AlertLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation("TenantAlerts", fields: [tenantId], references: [id], onDelete: Cascade)
  // Agency per-store attribution (additive). NULL = tenant-wide aggregate
  // row — this is what the weekly email and the default (unfiltered)
  // dashboard view read. Per-store rows are additional, not replacements.
  storeId    String?
  store      Store?   @relation("StoreAlertLogs", fields: [storeId], references: [id], onDelete: SetNull)
  alertType  String   @default("attack_detected")
  attackCount Int
  savedAmount Float
  sentAt     DateTime @default(now())

  @@index([tenantId, sentAt])
  @@index([storeId, sentAt])
}

// ========== Admin User (multi-key auth for internal dashboard) ==========
model AdminUser {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique // HMAC-SHA256(personalAdminKey, ADMIN_KEY_HASH_SECRET) — never store the raw key
  role       String    @default("readonly") // 'admin' | 'readonly'
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  adminActions    AdminAction[]    @relation("AdminUserActions")
  pausesActivated EmergencyPause[] @relation("AdminUserPauses")

  @@index([isActive])
}

// ========== Admin Action Log ==========
model AdminAction {
  id          String     @id @default(cuid())
  // Nullable: a system-wide action (pause-all / unpause-all) is not scoped
  // to any single tenant. Every existing row still has a real tenantId —
  // this only widens what future rows are allowed to be. onDelete changed
  // from Cascade to SetNull to match: a required relation can't use
  // SetNull, and Cascade would be wrong here anyway (a global AdminAction
  // was never "owned" by any one tenant to cascade-delete with).
  tenantId    String?
  tenant      Tenant?    @relation("TenantAdminActions", fields: [tenantId], references: [id], onDelete: SetNull)
  action      String   // suspend | reactivate | downgrade | extend-grace | set-plan | pause-blocking | unpause-blocking | pause-all | unpause-all
  note        String?
  success     Boolean
  resultCode  String   // e.g. SUSPENDED, ALREADY_SUSPENDED, NOT_FOUND, INVALID_DAYS
  createdAt   DateTime   @default(now())

  // Nullable for backward compatibility: rows logged before per-agent
  // accountability existed, and any action performed via the bootstrap
  // ADMIN_SECRET fallback (no AdminUser row to attribute it to).
  adminUserId String?
  adminUser   AdminUser? @relation("AdminUserActions", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([adminUserId, createdAt])
}

// ========== Emergency Pause (global / per-tenant kill-switch) ==========
model EmergencyPause {
  id                String     @id @default(cuid())
  // NULL = global pause (applies to every tenant). Deliberately NOT a
  // foreign key to Tenant — this table is an operational/audit trail of
  // pause events, not tenant-owned data, so rows should outlive tenant
  // deletion rather than cascading away (same no-FK pattern already used
  // by SignalStat.merchantId).
  tenantId          String?
  isActive          Boolean    @default(true)
  activatedAt       DateTime   @default(now())
  expiresAt         DateTime
  activatedById     String?
  activatedBy       AdminUser? @relation("AdminUserPauses", fields: [activatedById], references: [id], onDelete: SetNull)
  deactivatedAt     DateTime?
  deactivatedReason String?    // 'manual' | 'auto_expired' | 'superseded'

  @@index([tenantId, isActive])
  @@index([isActive, expiresAt])
}

// ========== Plugin Release (Update Distribution) ==========
model PluginRelease {
  id              String   @id @default(cuid())
  version         String
  channel         String   @default("stable")
  s3Key           String
  checksumSha256  String
  changelog       String?  @db.Text
  minWpVersion    String?
  testedWpVersion String?
  minPhpVersion   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([version, channel])
  @@index([channel, isActive, createdAt])
}

// ========== Update Download Token (single-use, short-lived) ==========
model UpdateDownloadToken {
  jti        String    @id
  releaseId  String
  tenantId   String
  expiresAt  DateTime
  usedAt     DateTime?

  @@index([expiresAt])
}

// ========== Protection Event (historical degradation log) ==========
// General-purpose log of any period during which a tenant's protection
// depth was reduced — used to power the Monthly Report's honest
// retrospective disclosure section. Deliberately generic (type field),
// not quota-specific: designed to also absorb subscription-grace-period
// events in a later phase without another migration.
model ProtectionEvent {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation("TenantProtectionEvents", fields: [tenantId], references: [id], onDelete: Cascade)

  type      String    // 'quota_exceeded' | (future: 'subscription_grace')
  startedAt DateTime  @default(now())
  endedAt   DateTime? // null = still ongoing

  // Free-form context, e.g. { "limit": 500, "monthlyCountAtTrigger": 500 }
  metadata  Json?

  @@index([tenantId, startedAt])
  @@index([tenantId, type, startedAt])
}
