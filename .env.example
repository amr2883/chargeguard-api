# ================================================================
# ChargeGuard Backend - Environment Variables Example
# ================================================================
# انسخ هذا الملف إلى .env واملأ القيم الفعلية قبل التشغيل.
# (Copy this file to .env and fill in actual values.)
#
# الأسطر التي تبدأ بـ # هي تعليقات للشرح فقط.
# القيم المكتوبة هنا هي أمثلة/افتراضية للتطوير المحلي.
# في الإنتاج، استبدلها بقيم قوية وآمنة.
# ================================================================

#### 1. قاعدة البيانات (Database) ####
# REQUIRED: مستخدم قاعدة البيانات
DB_USER=chargeguard
# REQUIRED: كلمة مرور قاعدة البيانات
DB_PASSWORD=change_me
# REQUIRED: اسم قاعدة البيانات
DB_NAME=chargeguard_db

# DATABASE_URL الكامل الذي يستخدمه التطبيق (Prisma).
# يتم بناؤه تلقائيا في Docker Compose، لكن إذا شغّلت التطبيق بدون Docker،
# يجب أن تملأ هذا الحقل يدويا وتعلق على المتغيرات المنفصلة أعلاه.
# DATABASE_URL=postgresql://chargeguard:change_me@localhost:5432/chargeguard_db?schema=public

#### 2. الأمان والمصادقة (Security) ####
# REQUIRED: مفتاح API للتطبيق (استخدم قيمة عشوائية طويلة)
API_KEY=your-api-key-here
# REQUIRED: سر تشفير Identity Graph (استخدم قيمة عشوائية 64 حرف)
IDENTITY_GRAPH_SECRET=your-identity-graph-secret-min-64-chars
# REQUIRED: سر تشفير Pattern Sharing (استخدم قيمة عشوائية 64 حرف)
PATTERN_SHARING_SECRET=your-pattern-sharing-secret-min-64-chars
# REQUIRED: سر تشفير تجزئة البطاقات (Card Hash)
CARD_HASH_SECRET=your-card-hash-secret-min-64-chars

# REQUIRED (للإنتاج): سر توقيع WooCommerce Webhook
# يُستخدم للتحقق من صحة الطلبات الواردة من متجر WooCommerce.
# هذا يختلف عن API_KEY - هذا خاص بالـ Webhook فقط.
WOOCOMMERCE_WEBHOOK_SECRET=your-webhook-secret-here

#### 3. خدمات الاستخبارات الخارجية (External APIs) ####
# اختياري: مفتاح IPQualityScore لتحليل الـ IP
IPQS_API_KEY=your-ipqs-api-key-here
# اختياري: وضع mock لتطوير بدون API (true/false) - لـ IP
MOCK_IP_INTEL=false
# اختياري: وضع mock لتطوير بدون API (true/false) - لـ BIN
MOCK_BIN_INTEL=false
# اختياري: تفعيل تحليل IP (true/false)
ENABLE_IP_INTEL=true
# اختياري: تفعيل تحليل البريد الإلكتروني (true/false)
ENABLE_EMAIL_INTEL=true
# اختياري: تفعيل تحليل BIN (true/false)
ENABLE_BIN_INTEL=true
# اختياري: API الخاص بـ BIN (free أو neutrino)
BIN_FALLBACK_API=free
# اختياري: مفتاح Neutrino API (إذا استخدمت neutrino)
NEUTRINO_API_KEY=

#### 4. المراقبة ولوحة التحكم (Monitoring) ####
# REQUIRED: كلمة مرور Grafana (للدخول إلى لوحة التحكم)
GRAFANA_PASSWORD=admin

#### 5. إعدادات عامة (General) ####
# منفذ التطبيق (اختياري، الافتراضي 3000)
PORT=3000
# بيئة التشغيل (production/development)
NODE_ENV=production
