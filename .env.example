#### 1. ŞÇÚÏÉ ÇáÈíÇäÇÊ (Database) ####
# REQUIRED: ãÓÊÎÏã ŞÇÚÏÉ ÇáÈíÇäÇÊ
DB_USER=chargeguard
# REQUIRED: ßáãÉ ãÑæÑ ŞÇÚÏÉ ÇáÈíÇäÇÊ
DB_PASSWORD=change_me
# REQUIRED: ÇÓã ŞÇÚÏÉ ÇáÈíÇäÇÊ
DB_NAME=chargeguard_db

# DATABASE_URL ÇáßÇãá ÇáĞí íÓÊÎÏãå ÇáÊØÈíŞ (Prisma).
# íÊã ÈäÇÄå ÊáŞÇÆíÇ İí Docker Compose¡ áßä ÅĞÇ ÔÛøáÊ ÇáÊØÈíŞ ÈÏæä Docker¡
# íÌÈ Ãä ÊãáÃ åĞÇ ÇáÍŞá íÏæíÇ æÊÚáŞ Úáì ÇáãÊÛíÑÇÊ ÇáãäİÕáÉ ÃÚáÇå.
# DATABASE_URL=postgresql://chargeguard:change_me@localhost:5432/chargeguard_db?schema=public

#### 2. ÇáÃãÇä æÇáãÕÇÏŞÉ (Security) ####
# REQUIRED: ãİÊÇÍ API ááÊØÈíŞ (ÇÓÊÎÏã ŞíãÉ ÚÔæÇÆíÉ ØæíáÉ)
API_KEY=your-api-key-here
# REQUIRED: ÓÑ ÊÔİíÑ Identity Graph (ÇÓÊÎÏã ŞíãÉ ÚÔæÇÆíÉ 64 ÍÑİ)
IDENTITY_GRAPH_SECRET=your-identity-graph-secret-min-64-chars
# REQUIRED: ÓÑ ÊÔİíÑ Pattern Sharing (ÇÓÊÎÏã ŞíãÉ ÚÔæÇÆíÉ 64 ÍÑİ)
PATTERN_SHARING_SECRET=your-pattern-sharing-secret-min-64-chars
# REQUIRED: ÓÑ ÊÔİíÑ ÊÌÒÆÉ ÇáÈØÇŞÇÊ (Card Hash)
CARD_HASH_SECRET=your-card-hash-secret-min-64-chars

# REQUIRED (ááÅäÊÇÌ): ÓÑ ÊæŞíÚ WooCommerce Webhook
# íõÓÊÎÏã ááÊÍŞŞ ãä ÕÍÉ ÇáØáÈÇÊ ÇáæÇÑÏÉ ãä ãÊÌÑ WooCommerce.
# åĞÇ íÎÊáİ Úä API_KEY - åĞÇ ÎÇÕ ÈÇáÜ Webhook İŞØ.

#### 3. ÎÏãÇÊ ÇáÇÓÊÎÈÇÑÇÊ ÇáÎÇÑÌíÉ (External APIs) ####
# ÇÎÊíÇÑí: ãİÊÇÍ IPQualityScore áÊÍáíá ÇáÜ IP
IPQS_API_KEY=your-ipqs-api-key-here
# ÇÎÊíÇÑí: æÖÚ mock áÊØæíÑ ÈÏæä API (true/false) - áÜ IP
MOCK_IP_INTEL=false
# ÇÎÊíÇÑí: æÖÚ mock áÊØæíÑ ÈÏæä API (true/false) - áÜ BIN
MOCK_BIN_INTEL=false
# ÇÎÊíÇÑí: ÊİÚíá ÊÍáíá IP (true/false)
ENABLE_IP_INTEL=true
# ÇÎÊíÇÑí: ÊİÚíá ÊÍáíá ÇáÈÑíÏ ÇáÅáßÊÑæäí (true/false)
ENABLE_EMAIL_INTEL=true
# ÇÎÊíÇÑí: ÊİÚíá ÊÍáíá BIN (true/false)
ENABLE_BIN_INTEL=true
# ÇÎÊíÇÑí: API ÇáÎÇÕ ÈÜ BIN (free Ãæ neutrino)
BIN_FALLBACK_API=free
# ÇÎÊíÇÑí: ãİÊÇÍ Neutrino API (ÅĞÇ ÇÓÊÎÏãÊ neutrino)
NEUTRINO_API_KEY=

#### 4. ÇáãÑÇŞÈÉ æáæÍÉ ÇáÊÍßã (Monitoring) ####
# REQUIRED: ßáãÉ ãÑæÑ Grafana (ááÏÎæá Åáì áæÍÉ ÇáÊÍßã)
GRAFANA_PASSWORD=admin

#### 5. ÅÚÏÇÏÇÊ ÚÇãÉ (General) ####
# ãäİĞ ÇáÊØÈíŞ (ÇÎÊíÇÑí¡ ÇáÇİÊÑÇÖí 3000)
PORT=3000
# ÈíÆÉ ÇáÊÔÛíá (production/development)
NODE_ENV=production
